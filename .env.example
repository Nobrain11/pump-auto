# PUMP AUTO — copy to .env.local for local dev ONLY.
# On Railway: set Variables in the dashboard. Do NOT paste these localhost values.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LOCAL only — on Railway use ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/pump_auto?schema=public
REDIS_URL=redis://localhost:6379

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_RPC_URL=

JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# openssl rand -base64 32
WALLET_ENCRYPTION_KEY=
AUTH_SECRET=

LOG_LEVEL=info
