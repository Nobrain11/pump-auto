{
  "name": "pump-auto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "worker:scanner": "tsx src/workers/scanner-worker.ts",
    "worker:execution": "tsx src/workers/execution-worker.ts",
    "worker:position": "tsx src/workers/position-worker.ts",
    "worker:bot": "tsx src/workers/bot.ts",
    "worker:all": "tsx src/workers/bot.ts",
    "test": "vitest",
    "test:unit": "vitest run --dir src/__tests__/unit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bcryptjs": "^3.0.2",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.10",
    "lucide-react": "^0.484.0",
    "next": "15.2.8",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.19.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "typescript": "^5",
    "vitest": "^3.0.9"
  }
}
